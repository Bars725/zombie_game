# Repo-level ignores.
# Unity-specific rules live in Zombie_game/.gitignore (GitHub Unity template, placed at the
# Unity project root as the template expects).

# Local tool output (logs, test results, builds)
/_out/

# IDE / OS
.vs/
.vscode/
.idea/
*.DotSettings.user
Thumbs.db
Desktop.ini
.DS_Store

# Files moved aside by tools (safe to delete by hand)
/_to_delete/

# Raw art drops from ComfyUI etc. (imported into Assets/_Project/Art by hand)
/_incoming_art/

# Obsidian personal UI state
/obsidian_zombie_game/.obsidian/workspace*.json
