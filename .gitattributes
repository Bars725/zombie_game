# Repo-wide attributes. Must live at the repo ROOT: [attr] macros only work in the top-level file.
# Based on gitattributes/gitattributes Unity template (MIT), adapted for the Unity project in /Zombie_game.

# Macros
[attr]lfs           filter=lfs diff=lfs merge=lfs -text
[attr]unity-json    text=auto eol=lf linguist-language=json
# text=auto: line endings are converted only for files git detects as text (binary .asset stays untouched).
# merge=unityyamlmerge: used only if the UnityYAMLMerge driver is configured; otherwise git does a normal merge.
[attr]unity-yaml    text=auto eol=lf merge=unityyamlmerge linguist-language=yaml

# Default: normalize text files
*               text=auto

# Docs / scripts
*.md            text
*.json          text
*.txt           text
*.bat           text eol=crlf
*.cmd           text eol=crlf

# Unity source files
*.cginc         text
*.compute       text linguist-language=hlsl
*.cs            text diff=csharp
*.hlsl          text linguist-language=hlsl
*.raytrace      text linguist-language=hlsl
*.shader        text

# Unity JSON files
*.asmdef        unity-json
*.asmref        unity-json
*.index         unity-json
*.inputactions  unity-json
*.shadergraph   unity-json
*.shadersubgraph unity-json

# UI Toolkit
*.tss           text diff=css linguist-language=css
*.uss           text diff=css linguist-language=css
*.uxml          text linguist-language=xml linguist-detectable

# Unity YAML files
*.anim          unity-yaml
*.asset         unity-yaml
*.brush         unity-yaml
*.controller    unity-yaml
*.flare         unity-yaml
*.fontsettings  unity-yaml
*.giparams      unity-yaml
*.guiskin       unity-yaml
*.lighting      unity-yaml
*.mask          unity-yaml
*.mat           unity-yaml
*.meta          unity-yaml
*.mixer         unity-yaml
*.overrideController unity-yaml
*.playable      unity-yaml
*.prefab        unity-yaml
*.preset        unity-yaml
*.renderTexture unity-yaml
*.scenetemplate unity-yaml
*.shadervariants unity-yaml
*.signal        unity-yaml
*.spriteatlas   unity-yaml
*.spriteatlasv2 unity-yaml
*.terrainlayer  unity-yaml
*.unity         unity-yaml
*.physicMaterial unity-yaml
*.physicsMaterial2D unity-yaml

# GitHub stats/diffs: hide third-party plugins and the lock file
Zombie_game/Assets/Plugins/**           linguist-generated
Zombie_game/Packages/packages-lock.json linguist-generated

