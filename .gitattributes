# Normalize text files to LF in the repo
* text=auto

# Code
*.cs        text diff=csharp
*.shader    text
*.hlsl      text
*.cginc     text
*.compute   text
*.asmdef    text
*.asmref    text
*.json      text
*.md        text
*.uxml      text
*.uss       text
*.inputactions text

# Windows scripts must stay CRLF or cmd.exe can misbehave
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Unity YAML assets (Force Text serialization) - keep LF everywhere.
# text=auto + eol=lf: converts only files git detects as text, so the odd binary .asset is left alone.
*.unity         text=auto eol=lf
*.prefab        text=auto eol=lf
*.asset         text=auto eol=lf
*.meta          text=auto eol=lf
*.mat           text=auto eol=lf
*.anim          text=auto eol=lf
*.controller    text=auto eol=lf
*.overrideController text=auto eol=lf
*.physicMaterial text=auto eol=lf
*.physicsMaterial2D text=auto eol=lf
*.playable      text=auto eol=lf
*.mask          text=auto eol=lf
*.brush         text=auto eol=lf
*.flare         text=auto eol=lf
*.fontsettings  text=auto eol=lf
*.guiskin       text=auto eol=lf
*.giparams      text=auto eol=lf
*.renderTexture text=auto eol=lf
*.spriteatlas   text=auto eol=lf
*.terrainlayer  text=auto eol=lf
*.mixer         text=auto eol=lf
*.shadervariants text=auto eol=lf
*.preset        text=auto eol=lf
*.lighting      text=auto eol=lf

# ---------- Git LFS (binary assets) ----------
# Run `git lfs install` once on this machine before committing any of these.
# Images
*.png  filter=lfs diff=lfs merge=lfs -text
*.jpg  filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.tga  filter=lfs diff=lfs merge=lfs -text
*.tif  filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text
*.psd  filter=lfs diff=lfs merge=lfs -text
*.exr  filter=lfs diff=lfs merge=lfs -text
*.hdr  filter=lfs diff=lfs merge=lfs -text
*.gif  filter=lfs diff=lfs merge=lfs -text
# Audio
*.wav  filter=lfs diff=lfs merge=lfs -text
*.mp3  filter=lfs diff=lfs merge=lfs -text
*.ogg  filter=lfs diff=lfs merge=lfs -text
*.aif  filter=lfs diff=lfs merge=lfs -text
*.aiff filter=lfs diff=lfs merge=lfs -text
*.flac filter=lfs diff=lfs merge=lfs -text
# 3D
*.fbx   filter=lfs diff=lfs merge=lfs -text
*.FBX   filter=lfs diff=lfs merge=lfs -text
*.obj   filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.dae   filter=lfs diff=lfs merge=lfs -text
*.3ds   filter=lfs diff=lfs merge=lfs -text
*.glb   filter=lfs diff=lfs merge=lfs -text
# Video
*.mp4  filter=lfs diff=lfs merge=lfs -text
*.mov  filter=lfs diff=lfs merge=lfs -text
*.webm filter=lfs diff=lfs merge=lfs -text
# Fonts
*.ttf  filter=lfs diff=lfs merge=lfs -text
*.otf  filter=lfs diff=lfs merge=lfs -text
# Baked data that is binary or very large
LightingData.asset filter=lfs diff=lfs merge=lfs -text !eol
# Archives / native binaries
*.zip  filter=lfs diff=lfs merge=lfs -text
*.7z   filter=lfs diff=lfs merge=lfs -text
*.dll  filter=lfs diff=lfs merge=lfs -text
*.so   filter=lfs diff=lfs merge=lfs -text
